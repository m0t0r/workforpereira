{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,

    // `@/*` is the app's own alias, which shadcn writes into any component it adds here rather
    // than into `@repo/design-system`. `@repo/design-system` itself needs no mapping: it resolves
    // through the workspace symlink and that package's `exports` map, the way `@repo/ui` did.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
