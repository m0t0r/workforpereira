{
  "name": "workforpereira",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "coverage": "vitest run --coverage",
    "boundaries": "turbo boundaries",
    "bootstrap": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:seed": "pnpm --filter @repo/consent seed-documents",
    "db:check": "turbo run db:check",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:psql": "docker compose exec postgres psql -U encuentra -d encuentra"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-turbo": "^2.10.12",
    "oxfmt": "0.63.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
