{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Overrides base.json's NodeNext — see `docs/module-package-recipe.md` §3.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vitest/globals", "node"],

    // For `scripts/seed-documents.ts` alone, which `tsx` runs directly and which therefore names
    // its two relative imports with a real extension. Everything under `src/` is read by a bundler
    // and stays extensionless. Legal only because `noEmit` is set, and the same allowance
    // `@repo/notifications` makes for `scripts/drain.ts`.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
